{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/app/__mocks__/*.js",
    ".storybook/**/*.ts",
    "@types/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
